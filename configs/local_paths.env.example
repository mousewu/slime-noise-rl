# Copy this file outside version control or edit the paths before sourcing it.
# All paths must already exist locally; the project never downloads models or data.
export SLIME_DIR=/workspace/slime
export HF_CHECKPOINT=/models/Qwen3-4B-Instruct-2507
export MEGATRON_CHECKPOINT=/models/Qwen3-4B-Instruct-2507_torch_dist
export ALFWORLD_ROOT=/datasets/alfworld/json_2.1.1

# Optional smoke-test settings.
export CUDA_VISIBLE_DEVICES=0,1
export SMOKE_MANIFEST=/workspace/slime-noise-rl/data/alfworld/train-smoke-8.jsonl
export SMOKE_OUTPUT=/workspace/slime-noise-rl/runs/smoke-2gpu-local
